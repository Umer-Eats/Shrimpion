# Copy to .env.local (and add the same keys in Vercel → Project → Settings → Environment Variables).
# Until these are set, Shrimpion runs in "local mode": progress is saved in the browser only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
