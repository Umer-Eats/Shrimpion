# Copy to .env (and add the same keys in Vercel → Project → Settings → Environment Variables).

# --- Sign-in (Firebase Auth only). Public web config; safe in the browser. ---
# Until these are set, Shrimpion runs in "local mode": progress is saved in the browser only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Game data (Turso). SERVER ONLY: never prefix these with VITE_. ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
